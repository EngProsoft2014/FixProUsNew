                                                                           HorizontalTextAlignment="Center"
                                                                           VerticalTextAlignment="Center"></Label>
                                                                </StackLayout>

                                                                <StackLayout Orientation="Horizontal">

                                                                    <Label Text="{Binding ReasonName}" HorizontalOptions="StartAndExpand"
                                                                           FontSize="12"
                                                                           FontAttributes="Bold"
                                                                           TextColor="Gray" 
                                                                           HorizontalTextAlignment="Center"
                                                                           VerticalTextAlignment="Center">
                                                                    </Label>

                                                                    <Label Text="{Binding CampaignName}" 
                                                                           HorizontalOptions="End"
                                                                           TextColor="Gray"
                                                                           FontSize="12" 
                                                                           FontAttributes="Bold"
                                                                           HorizontalTextAlignment="Center"
                                                                           VerticalTextAlignment="Center"></Label>
                                                                </StackLayout>
                                                            </StackLayout>

                                                            <StackLayout.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CallsViewModel}}, Path=SelectCallDetailsCommand}" CommandParameter="{Binding}"></TapGestureRecognizer>
                                                            </StackLayout.GestureRecognizers>
                                                        </StackLayout>
                                                    </StackLayout>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                            <CollectionView.ItemsLayout>
                                                <GridItemsLayout Orientation="Vertical" VerticalItemSpacing="15"></GridItemsLayout>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.Triggers>
                                                <DataTrigger TargetType="CollectionView" Binding="{Binding LstCalls.Count}" Value="0">
                                                    <Setter Property="IsVisible" Value="False"></Setter>
                                                    <Setter Property="HeightRequest" Value="0"></Setter>
                                                </DataTrigger>
                                            </CollectionView.Triggers>
                                        </CollectionView>

