                                                        <MultiTrigger.Conditions>
                                                            <BindingCondition Binding="{Binding LstCustomers.Count}" Value="0" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="IsVisible" Value="True"></Setter>
                                                    </MultiTrigger>
                                                </StackLayout.Triggers>
                                            </StackLayout>
