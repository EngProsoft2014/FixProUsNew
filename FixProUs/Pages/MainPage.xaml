                                                <Image.Source>
                                                    <FontImageSource Glyph="+" Color="White" FontFamily="FontIconSolid"></FontImageSource>
                                                </Image.Source>
                                            </Image>

                                            <Border.Shadow>
                                                <Shadow Brush="{OnPlatform Android=Gray, iOS=Gray}" Radius="{OnPlatform Android=5,iOS=3}"></Shadow>
                                            </Border.Shadow>
